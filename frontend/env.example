# Copy to frontend/.env.local for local work. Do not commit the copy.
# A production build requires an absolute https REACT_APP_BACKEND_URL with no credentials and no /api path.
# Localhost is allowed only for development.
REACT_APP_BACKEND_URL=http://localhost:8000
# Public pk. token only. Never put a server token, Stripe key, or MongoDB URL here.
REACT_APP_MAPBOX_PUBLIC_TOKEN=
# Leave unset unless a live GPS trial is approved. Operational visits do not publish a simulated path.
# REACT_APP_TRACKING_MODE=
