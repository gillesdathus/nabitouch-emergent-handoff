# Copy to backend/.env for local work. Do not commit the copy. Do not reuse passwords from git history.
MONGO_URL=mongodb://localhost:27017
DB_NAME=nabitouch_dev
APP_ENV=development
# false keeps the operational database on the launch catalogue.
# true loads the fictional clinic and must not be used as the business database.
DEMO_MODE=false
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
CORS_ORIGINS=http://localhost:3000
APP_URL=https://localhost:3000
EMAIL_PROVIDER=mock
# Cancellation, reschedule, and assignment email. Unset or false stays off.
# EMAIL_LIFECYCLE_ENABLED=false
# Practitioner booking / cancel / reschedule / reassignment email. Unset stays on.
# PRACTITIONER_BOOKING_EMAIL_ENABLED=true
EMAIL_FROM_NAME=Nabitouch
JWT_SECRET=replace-with-at-least-16-characters
OWNER_EMAIL=owner@example.com
# Bootstrap-only for first owner create. Do not sync the live account password here after it changes.
OWNER_PASSWORD=replace-me
DEMO_PASSWORD=replace-me
PAYMENT_MODE=simulated
# Stripe test secret (sk_test_...) and webhook secret. Leave empty until sandbox credentials exist.
# A live secret (sk_live_) is refused. A redirect from Checkout is not payment.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Secret Mapbox token for Geocoding and Directions. Leave empty outside production to use the local Edmonton list.
# Public-scope pk. token with no URL restriction, or an sk. token. Never put the browser token here.
MAPBOX_TOKEN=
# Suggest and /geo/check use temporary geocoding when false. Confirm/booking persistence needs true
# (and Mapbox account permission/billing for stored visit geocodes).
MAPBOX_PERMANENT_GEOCODING=false
# Ephemeral tracking sessions. Required in production. Not a location-history database.
# Production must use rediss:// and a password, for example rediss://:password@redis.example:6380/0
REDIS_URL=redis://localhost:6379/0
# 32 bytes, url-safe base64. Required in production. Do not store this in MongoDB or git.
# Backups of encrypted fields and files cannot be read without this key.
FIELD_ENCRYPTION_KEY=
# Optional previous key, used only to decrypt during a rotation.
FIELD_ENCRYPTION_KEY_PREVIOUS=
# Optional clamd host. When set, a file stays in quarantine if the scanner cannot be reached.
CLAMAV_HOST=
CLAMAV_PORT=3310
# Read-only legacy source. Leave empty until a backup is approved and the owner authorizes an import.
LEGACY_MONGO_URL=
LEGACY_DB_NAME=
# Production sets these explicitly in deploy/env.hostinger.example. Unset means off, including in development.
# DOCUMENT_UPLOADS_ENABLED=false
# Security Shield fleet (vehicles / assignments). Independent of clinical document uploads. Unset means off.
# SECURITY_SHIELD_FLEET_ENABLED=false
# SECURITY_SHIELD_DOCS_ENABLED=false
# SECURITY_SHIELD_ARRIVAL_CODE_ENABLED=false
# Block On My Way / vehicle assign when driving docs are expired (does not cancel visits).
# SECURITY_SHIELD_EXPIRY_ENFORCEMENT=false
# Opt-in short GPS breadcrumb ring during travel for safety reconstruction (ETA stays 5 minutes).
# SECURITY_SHIELD_SAFETY_SAMPLING_ENABLED=false
# Optional pepper for arrival-code hashing (defaults to JWT_SECRET).
# SHIELD_CODE_PEPPER=
# Client profile avatars are separate from clinical/insurance file uploads. Unset means on.
# PROFILE_PHOTOS_ENABLED=true
# STRIPE_CARD_CHECKOUT_ENABLED=false
# LEGACY_PATIENT_IMPORT_ENABLED=false
# HOSTING_STRATEGY=shared-vps
# EMAIL_PROVIDER=resend
# EMAIL_FROM=Nabitouch <bookings@nabitouch.com>
# RESEND_API_KEY=
# RESEND_WEBHOOK_SECRET=
# EMAIL_TEST_RECIPIENT=info@nabitouch.com
# Acceptance: exact approved inbox/sender addresses, worker off; no automatic delivery.
EMAIL_ACCEPTANCE_MODE=false
EMAIL_ALLOWED_RECIPIENTS=
EMAIL_APPROVED_SENDERS=
NOTIFICATION_WORKER_ENABLED=true
EMAIL_REMINDERS_ENABLED=false
# LOG_LEVEL=INFO
# Push (Firebase Admin SDK). Keep PUSH_ENABLED=false until approved.
# FIREBASE_SERVICE_ACCOUNT_FILE must point outside /app, chmod 600, project_id must equal FIREBASE_PROJECT_ID.
# PUSH_ENABLED=false
# PUSH_DRY_RUN=true
# FIREBASE_PROJECT_ID=
# FIREBASE_SERVICE_ACCOUNT_FILE=/root/.nabitouch/secrets/firebase-admin.json
