# Copy to ignored backend/.env.resend.local. Saving credentials does not authorize a send.
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
EMAIL_PROVIDER=disabled
EMAIL_FROM=Nabitouch <bookings@nabitouch.com>
EMAIL_REPLY_TO=info@nabitouch.com
EMAIL_ACCEPTANCE_MODE=true
EMAIL_ALLOWED_RECIPIENTS=
EMAIL_APPROVED_SENDERS=
EMAIL_TEST_RECIPIENT=
NOTIFICATION_WORKER_ENABLED=false
EMAIL_LIFECYCLE_ENABLED=false
EMAIL_REMINDERS_ENABLED=false
INVOICE_EMAIL_ENABLED=false
STATEMENT_EMAIL_ENABLED=false
REVIEW_INVITES_ENABLED=false
## Set these only after documented provider isolation and exact-preview owner approval.
EMAIL_PROVIDER_ISOLATION_CONFIRMED=false
EMAIL_APPROVED_PREVIEW_SHA256=
