STAGING_API_IMAGE=nabitouch-staging-api:replace-me
STAGING_WEB_IMAGE=nabitouch-staging-web:replace-me
STAGING_API_ENV=/etc/nabitouch-staging/api.env
STAGING_MONGO_ROOT_PASSWORD_FILE=/etc/nabitouch-staging/mongo-root-password
STAGING_MONGO_APP_PASSWORD_FILE=/etc/nabitouch-staging/mongo-app-password
STAGING_MONGO_KEYFILE=/etc/nabitouch-staging/mongo.key
STAGING_REDIS_PASSWORD_FILE=/etc/nabitouch-staging/redis-password
STAGING_REDIS_ACL_FILE=/etc/nabitouch-staging/redis-users.acl
STAGING_REDIS_TLS_DIR=/etc/nabitouch-staging/redis-tls
STAGING_HTTP_PORT=18081
