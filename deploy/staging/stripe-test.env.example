# Overlay these values into the protected server api.env ONLY for the authorized
# Stripe sandbox phase. Not a complete standalone application environment.
# Replace placeholders outside Git. Never place any of these in VITE_/REACT_APP_.
PAYMENT_MODE=test
STRIPE_CARD_CHECKOUT_ENABLED=true
STRIPE_SECRET_KEY=<SANDBOX_SERVER_SECRET_OR_RESTRICTED_TEST_KEY>
STRIPE_WEBHOOK_SECRET=<SANDBOX_ENDPOINT_SIGNING_SECRET>
EMAIL_PROVIDER=disabled
EMAIL_LIFECYCLE_ENABLED=false
INVOICE_EMAIL_ENABLED=false
STATEMENT_EMAIL_ENABLED=false
REVIEW_INVITES_ENABLED=false
SMS_ENABLED=false
PUSH_ENABLED=false
PUSH_DRY_RUN=true
# Keep GIFTCARDS_ENABLED=false. New plan purchases/refunds are blocked in this
# phase; existing package credits can be applied to bookings normally.
GIFTCARDS_ENABLED=false
