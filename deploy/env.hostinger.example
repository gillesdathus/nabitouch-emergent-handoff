# Template for the future file /etc/nabitouch-next.env
# Do not create that file on the VPS during configuration preparation.
# Do not commit a filled copy. Every secret below is a placeholder.
#
# On the server, after a separate deployment approval:
#   install -o root -g root -m 600 /etc/nabitouch-next.env
# The API reads this file. It is not a shell script. Do not source it into a login session.
# Keep a second copy of FIELD_ENCRYPTION_KEY in a password manager, not beside the database archive.

APP_ENV=production
DEMO_MODE=false
HOSTING_STRATEGY=shared-vps
LOG_LEVEL=INFO

APP_URL=https://nabitouch.com
CORS_ORIGINS=https://nabitouch.com
COOKIE_SECURE=true
COOKIE_SAMESITE=lax

# Generate on the server. At least 16 characters. Do not reuse a development value.
JWT_SECRET=
OWNER_EMAIL=info@nabitouch.com
OWNER_PASSWORD=

# Private single-node replica set. No host port. Replace the password.
# Replica set name is rs0. Initialize it only during an approved deployment.
MONGO_URL=mongodb://ntnext:replace-me@mongo:27017/nabitouch_prod?replicaSet=rs0&authSource=admin
DB_NAME=nabitouch_prod

# The password in REDIS_URL must match REDIS_PASSWORD. TLS certs live on nt-next-redis-certs.
REDIS_PASSWORD=
REDIS_URL=rediss://:replace-me@redis:6379/0?ssl_cert_reqs=required&ssl_ca_certs=/certs/ca.crt

# 32 bytes, url-safe base64. Required. Store the same value off the server, apart from backups.
FIELD_ENCRYPTION_KEY=
FIELD_ENCRYPTION_KEY_PREVIOUS=

# nabitouch-backend-prod: public-scope pk. token for Geocoding v6 and Directions, with no URL restriction.
# The browser token, nabitouch-frontend-prod, belongs in the frontend build file and does not belong here.
MAPBOX_TOKEN=

EMAIL_PROVIDER=resend
EMAIL_FROM_NAME=Nabitouch
EMAIL_FROM=Nabitouch <bookings@nabitouch.com>
EMAIL_REPLY_TO=info@nabitouch.com
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
# Approved smoke-test recipient. The application does not send mail because this variable is set.
EMAIL_TEST_RECIPIENT=info@nabitouch.com

# Initial launch. Set true only in a later approved change.
DOCUMENT_UPLOADS_ENABLED=false
# Security Shield (approved). Independent of DOCUMENT_UPLOADS_ENABLED — clinical files stay off
# (production secrets assessor requires DOCUMENT_UPLOADS_ENABLED=false on shared-VPS).
SECURITY_SHIELD_FLEET_ENABLED=true
SECURITY_SHIELD_DOCS_ENABLED=true
SECURITY_SHIELD_ARRIVAL_CODE_ENABLED=true
SECURITY_SHIELD_EXPIRY_ENFORCEMENT=true
SECURITY_SHIELD_SAFETY_SAMPLING_ENABLED=true
STRIPE_CARD_CHECKOUT_ENABLED=false
LEGACY_PATIENT_IMPORT_ENABLED=false

# Leave empty. The shared VPS refuses a ClamAV host at startup.
CLAMAV_HOST=
CLAMAV_PORT=3310

# Leave empty until a future test-mode activation. sk_live_ is refused.
PAYMENT_MODE=live
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
