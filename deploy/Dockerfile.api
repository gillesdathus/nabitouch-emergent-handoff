FROM python:3.12-slim

WORKDIR /app
COPY backend/requirements.txt .
RUN pip install --no-cache-dir --require-hashes -r requirements.txt && pip check
COPY backend/ .
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 CMD python -c "import json,urllib.request; h=json.load(urllib.request.urlopen('http://127.0.0.1:8000/api/health',timeout=3)); assert h['mongo']=='ok' and h['redis']=='ok'"
CMD ["uvicorn", "server:app", "--host", "0.0.0.0", "--port", "8000"]
